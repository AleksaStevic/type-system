{
    "compilerOptions": {
        "lib": [
            "ES2022"
        ],
        "target": "es2022",
        "strict": true,
        "strictNullChecks": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "moduleResolution": "Bundler",
        "baseUrl": ".",
        "paths": {
            "@type-system/*": [
                "./src/*"
            ]
        }
    }
}