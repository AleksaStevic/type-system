{
	"compilerOptions": {
		"lib": ["ES2022"],
		"target": "es2022",
		"strict": true,
		"strictNullChecks": true,
		"noImplicitAny": true,
		"noImplicitThis": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"experimentalDecorators": true,
		"moduleResolution": "Bundler",
		"types": ["node", "vitest/globals"],
		"paths": {
			"@type-system/*": ["./src/*"]
		}
	}
}
